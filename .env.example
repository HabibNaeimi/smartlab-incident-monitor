# InfluxDB initialization for local Docker Compose
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=smartlab-admin
DOCKER_INFLUXDB_INIT_PASSWORD=CHANGE_ME_STRONG_LOCAL_PASSWORD
DOCKER_INFLUXDB_INIT_ORG=smartlab
DOCKER_INFLUXDB_INIT_BUCKET=telemetry
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM_LOCAL_TOKEN

# MQTT client configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=CHANGE_ME_UNIQUE_CLIENT_ID
MQTT_KEEP_ALIVE=60
MQTT_CLEAN_SESSION=false
MQTT_QOS_DEFAULT=0
MQTT_RECONNECT_DELAY=5
MQTT_TOPIC_ROOT=smartlab
MQTT_SITE=polito-smartlab