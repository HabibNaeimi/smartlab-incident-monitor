# InfluxDB initialization for local Docker Compose
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=smartlab-admin
DOCKER_INFLUXDB_INIT_PASSWORD=CHANGE_ME_STRONG_LOCAL_PASSWORD
DOCKER_INFLUXDB_INIT_ORG=smartlab
DOCKER_INFLUXDB_INIT_BUCKET=telemetry
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM_LOCAL_TOKEN

# Example bootstrap for ONE application service; adapt its name and address.
# Python does not automatically read this file. See docs/configuration.md.
SERVICE_NAME=dashboard
INSTANCE_ID=dashboard-01
BASE_URL=http://localhost:8090
SERVICE_CATALOG_URL=http://localhost:8081
SERVICE_BOOTSTRAP_PATH=

# Supply each secret only to its owning service, never to every container.
INFLUXDB_TOKEN=
TELEGRAM_BOT_TOKEN=
LLM_API_KEY=

# Broker settings, site, topic root, and peer URLs come from Service Catalog.
# Do not restore the legacy MQTT_* application environment settings.
